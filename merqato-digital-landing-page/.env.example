# Copy this file to .env.local and replace the placeholders with values from
# Supabase Dashboard > Project Settings > API. Never use a service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Legacy projects may use this instead of VITE_SUPABASE_PUBLISHABLE_KEY.
# VITE_SUPABASE_ANON_KEY=your-anon-key

# Admin backoffice passkey (triple-click the logo to open the access gate).
# Choose any strong, private value. If unset, the backoffice will refuse entry.
VITE_ADMIN_PASSKEY=